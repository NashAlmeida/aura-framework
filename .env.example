BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
MARK_LVII_PATH=./mark_lvii
LOG_LEVEL=INFO

# Phase 2 — set OPENAI_API_KEY to use a real LLM ReAct agent.
# Leave empty to use the local demo planner (no external API calls).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Langfuse tracing — Settings > API Keys in your Langfuse project.
# Leave the keys empty to run without tracing.
# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
